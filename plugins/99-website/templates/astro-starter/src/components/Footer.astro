---
import site from "../data/site.json";
import { t, telHref, privacyUrl, termsUrl } from "../lib/ui.js";
import Socials from "./Socials.astro";
const b = site.business;
---
<footer class="mt-16 bg-brand-deep text-paper">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold">{b.name}</p>
      {telHref(b.phone) && <p class="mt-2"><a href={telHref(b.phone)} class="underline">{b.phone}</a></p>}
      {b.email && <p><a href={`mailto:${b.email}`} class="underline">{b.email}</a></p>}
      {b.hours && <p class="mt-2 text-sm opacity-80">{b.hours}</p>}
      <Socials class="mt-5" />
    </div>
    <nav aria-label={t.footerServices}>
      <p class="font-semibold">{t.footerServices}</p>
      <ul class="mt-2 space-y-1 text-sm">{site.nav.services.map((s) => <li><a href={s.url} class="hover:underline">{s.name}</a></li>)}</ul>
    </nav>
    {site.nav.areas.length > 0 && (
      <nav aria-label={t.footerAreas}>
        <p class="font-semibold">{t.footerAreas}</p>
        <ul class="mt-2 space-y-1 text-sm">{site.nav.areas.map((a) => <li><a href={a.url} class="hover:underline">{a.name}</a></li>)}</ul>
      </nav>
    )}
  </div>
  <div class="border-t border-paper/20 px-4 py-4 text-center text-sm opacity-80">
    {b.demo && <p>{t.demo(b.name)}</p>}
    <p>
      <a href={privacyUrl} class="underline">{t.privacy}</a>
      {termsUrl && <> <span aria-hidden="true">·</span> <a href={termsUrl} class="underline">{t.terms}</a></>}
    </p>
  </div>
</footer>
