---
import site from "../data/site.json";
import { t, telHref } from "../lib/ui.js";
const { content } = Astro.props;
const b = site.business;
const tel = telHref(b.phone);
---
<aside class="rounded-md bg-surface p-6 md:sticky md:top-6">
  <h2 class="mt-0 text-xl">{t.glance}</h2>
  <dl class="mt-4 space-y-3 text-base">
    {content.price && <div><dt class="text-sm text-muted">{t.price}</dt><dd class="font-semibold">{content.price}</dd></div>}
    {content.trust && <div><dt class="text-sm text-muted">{t.cover}</dt><dd class="font-semibold">{content.trust}</dd></div>}
    <div><dt class="text-sm text-muted">{t.estimateLabel}</dt><dd class="font-semibold">{t.estimateValue}</dd></div>
  </dl>
  {b.primary_cta === "form" && <a href="#estimate" class="mt-6 block rounded-md bg-brand px-5 py-3 text-center font-medium text-paper transition-colors hover:bg-brand-deep">{t.estimateCta}</a>}
  {tel && <a href={tel} class="mt-3 block rounded-md border border-brand px-5 py-3 text-center font-medium text-brand transition-colors hover:bg-brand hover:text-paper">{t.call(b.phone)}</a>}
</aside>
