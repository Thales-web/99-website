---
import site from "../data/site.json";
import { t, telHref, contactUrl } from "../lib/ui.js";
const b = site.business;
const { heading = t.ctaBandHeading, text = t.ctaBandText } = Astro.props;
const tel = telHref(b.phone);
---
<section class="my-14 rounded-md bg-brand px-6 py-10 text-paper md:px-12 md:py-14">
  <h2 class="mt-0 text-2xl">{heading}</h2>
  <p class="mt-2">{text}</p>
  <p class="mt-4 flex flex-wrap gap-3">
    {b.primary_cta === "form" && <a href={contactUrl} class="rounded-md bg-paper px-4 py-2 font-medium text-ink hover:bg-surface">{t.estimateCta}</a>}
    {tel && <a href={tel} class="rounded-md border border-paper px-4 py-2 font-medium hover:bg-paper hover:text-ink">{t.call(b.phone)}</a>}
  </p>
</section>
