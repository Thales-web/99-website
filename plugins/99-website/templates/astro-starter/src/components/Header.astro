---
import site from "../data/site.json";
import { t, telHref, contactUrl, aboutUrl, servicesHubUrl, areasHubUrl } from "../lib/ui.js";
const b = site.business;
const cta = b.primary_cta === "form" || !telHref(b.phone)
  ? { href: contactUrl, label: t.estimateCta }
  : { href: telHref(b.phone), label: t.call(b.phone) };
const links = [
  ...(servicesHubUrl ? [{ href: servicesHubUrl, label: t.navServices }] : []),
  ...(site.nav.areas.length ? [{ href: areasHubUrl, label: t.navAreas }] : []),
  ...(aboutUrl ? [{ href: aboutUrl, label: t.navAbout }] : []),
  { href: contactUrl, label: t.navContact },
];
---
<header class="border-b border-ink/10 bg-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="font-display text-xl font-semibold text-brand">{b.name}</a>
    <nav aria-label={t.mainNav} class="hidden items-center gap-6 md:flex">
      {links.map((l) => <a href={l.href} class="hover:text-brand">{l.label}</a>)}
      <a href={cta.href} class="rounded-md bg-brand px-4 py-2 font-medium text-paper hover:bg-ink">{cta.label}</a>
    </nav>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-ink/20 px-3 py-2">{t.menu}</summary>
      <nav aria-label={t.mobileNav} class="absolute right-0 z-10 mt-2 flex w-64 flex-col gap-1 rounded-md border border-ink/10 bg-paper p-3 shadow">
        {links.map((l) => <a href={l.href} class="rounded px-2 py-2 hover:bg-ink/5">{l.label}</a>)}
        {site.nav.services.map((s) => <a href={s.url} class="rounded px-2 py-1 text-sm hover:bg-ink/5">{s.name}</a>)}
        <a href={cta.href} class="mt-2 rounded-md bg-brand px-3 py-2 text-center font-medium text-paper">{cta.label}</a>
      </nav>
    </details>
  </div>
</header>
