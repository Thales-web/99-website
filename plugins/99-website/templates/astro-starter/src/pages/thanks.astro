---
// Where the estimate form lands after a successful send. Never indexed, never in the sitemap (sitemap.xml lists site.pages only).
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import { t, telHref } from "../lib/ui.js";
const b = site.business;
const page = { url: "/thanks/", title: t.thanksTitle(b.name), type: "legal", page_name: t.thanksH1, parent: "/" };
const content = { description: t.thanksDesc(b.name) };
const tel = telHref(b.phone);
---
<Base page={page} content={content} noindex>
<div class="mx-auto max-w-3xl px-4 py-16">
  <h1 class="text-4xl font-semibold">{t.thanksH1}</h1>
  <p class="mt-4 text-lg">{tel ? <>{t.thanksPre}<a href={tel} class="font-semibold text-brand underline">{b.phone}</a>{t.thanksPost}</> : t.thanksLead}</p>
  <p class="mt-6"><a href="/" class="underline">{t.thanksBack}</a></p>
</div>
</Base>
